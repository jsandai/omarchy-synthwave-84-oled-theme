# Synthwave OLED Plymouth theme: boot, LUKS unlock and shutdown/reboot.
# Generated assets come from build.sh; all coordinates are logical pixels.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

FPS = 50;                       # Plymouth's default refresh rate
global.frame = 0;
global.mode = Plymouth.GetMode();

#----------------------------------------- Logo + pulsing glow --------------------------------

logo.image = Image("logo.png");
logo.x = Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30;
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(logo.x, logo.y, 2);

glow.image = Image("glow.png");
glow.sprite = Sprite(glow.image);
glow.sprite.SetPosition(logo.x - 60, logo.y - 60, 1);
glow.sprite.SetOpacity(0);

global.fade_start = -1;         # frame the shutdown/reboot fade-out began
GLOW = "@GLOW@";                # pulse | static | off, set by build.sh

fun glow_opacity() {
  if (GLOW == "off") {
    return 0;
  }
  a = 0.725;
  if (GLOW == "pulse") {
    # cosine pulse 0.45 -> 1.0 -> 0.45 over 3 s
    phase = (global.frame % (3 * FPS)) / (3 * FPS);
    a = 0.725 - 0.275 * Math.Cos(phase * 2 * Math.Pi);
  }
  if (global.mode == "shutdown" || global.mode == "reboot") {
    if (global.fade_start < 0) global.fade_start = global.frame;
    k = 1 - (global.frame - global.fade_start) / (1.5 * FPS);
    if (k < 0) k = 0;
    a = a * k;
  }
  return a;
}

#----------------------------------------- Password dialog --------------------------------

entry.image = Image("entry.png");
entry.error_image = Image("entry-error.png");
EP = 20;                        # padding baked around the entry box
entry.w = entry.image.GetWidth() - 2 * EP;
entry.h = entry.image.GetHeight() - 2 * EP;
entry.x = Window.GetWidth() / 2 - entry.w / 2;
entry.y = logo.y + logo.image.GetHeight() + 45;
entry.cy = entry.y + entry.h / 2;
entry.sprite = Sprite(entry.image);
entry.error_sprite = Sprite(entry.error_image);

lock.image = Image("lock.png");
LKP = 12;
lock.sprite = Sprite(lock.image);

bullet.image = Image("bullet.png");
bullet.flash_image = Image("bullet-flash.png");
bullet.sprites = [];
bullet.flash_sprites = [];
BULLET_PITCH = 13;
MAX_BULLETS = Math.Int((entry.w - 18 - 18) / BULLET_PITCH);

caret.image = Image("caret.png");
caret.sprite = Sprite(caret.image);

global.dialog_shown = 0;
global.password_shown = 0;
global.bullets = 0;
global.submitted = 0;           # a passphrase was entered and the dialog closed
global.key_frame = -1000;       # frame of the last keystroke
global.error_frame = -1000;     # frame the re-prompt (wrong passphrase) arrived

fun place_dialog(dx) {
  entry.sprite.SetPosition(entry.x - EP + dx, entry.y - EP, 10001);
  entry.error_sprite.SetPosition(entry.x - EP + dx, entry.y - EP, 10002);
  lock.sprite.SetPosition(entry.x - 10 - lock.image.GetWidth() + LKP + dx,
                          entry.cy - lock.image.GetHeight() / 2 - 2, 10001);
  for (i = 0; i < MAX_BULLETS; i++) {
    if (bullet.sprites[i]) {
      bx = entry.x + 18 + i * BULLET_PITCH + dx;
      bullet.sprites[i].SetPosition(bx, entry.cy - 4, 10003);
      bullet.flash_sprites[i].SetPosition(bx, entry.cy - 4, 10004);
    }
  }
  n = global.bullets;
  if (n > MAX_BULLETS) n = MAX_BULLETS;
  caret.sprite.SetPosition(entry.x + 18 + n * BULLET_PITCH + dx, entry.cy - 10, 10003);
}

fun set_dialog_opacity(a) {
  entry.sprite.SetOpacity(a);
  lock.sprite.SetOpacity(a);
  if (a == 0) {
    entry.error_sprite.SetOpacity(0);
    caret.sprite.SetOpacity(0);
    for (i = 0; bullet.sprites[i]; i++) {
      bullet.sprites[i].SetOpacity(0);
      bullet.flash_sprites[i].SetOpacity(0);
    }
  }
}

fun animate_dialog() {
  if (global.dialog_shown == 0) {
    return 0;
  }
  # newest bullet flashes white, fading to cyan over 0.3 s
  i = global.bullets - 1;
  if (i >= MAX_BULLETS) i = MAX_BULLETS - 1;
  if (i >= 0 && bullet.flash_sprites[i]) {
    f = 1 - (global.frame - global.key_frame) / (0.3 * FPS);
    if (f < 0) f = 0;
    bullet.flash_sprites[i].SetOpacity(f);
  }
  # block caret: solid while typing, then blinks at 1 Hz
  since_key = global.frame - global.key_frame;
  if (since_key < 0.5 * FPS || (global.frame % FPS) < FPS / 2) {
    caret.sprite.SetOpacity(1);
  }
  else {
    caret.sprite.SetOpacity(0);
  }
  # wrong passphrase: red flash (0.8 s fade) + decaying shake (0.45 s)
  e = global.frame - global.error_frame;
  r = 1 - e / (0.8 * FPS);
  if (r < 0) r = 0;
  entry.error_sprite.SetOpacity(r);
  entry.sprite.SetOpacity(1 - r);
  dx = 0;
  s = e / (0.45 * FPS);
  if (s < 1) dx = Math.Int(10 * (1 - s) * Math.Sin(s * 6 * Math.Pi));
  place_dialog(dx);
}

fun display_password_callback(prompt, bullets) {
  global.password_shown = 1;
  stop_fake_progress();
  hide_progress_bar();

  if (global.dialog_shown == 0) {
    global.dialog_shown = 1;
    set_dialog_opacity(1);
    if (global.submitted == 1 && bullets == 0) global.error_frame = global.frame;
    global.submitted = 0;
  }

  if (bullets > global.bullets) global.key_frame = global.frame;
  global.bullets = bullets;

  for (i = 0; i < MAX_BULLETS; i++) {
    if (i < bullets) {
      if (!bullet.sprites[i]) {
        bullet.sprites[i] = Sprite(bullet.image);
        bullet.flash_sprites[i] = Sprite(bullet.flash_image);
        bullet.flash_sprites[i].SetOpacity(0);
      }
      bullet.sprites[i].SetOpacity(1);
    }
    else if (bullet.sprites[i]) {
      bullet.sprites[i].SetOpacity(0);
      bullet.flash_sprites[i].SetOpacity(0);
    }
  }
  place_dialog(0);
}

fun display_normal_callback() {
  if (global.dialog_shown == 1 && global.bullets > 0) global.submitted = 1;
  global.dialog_shown = 0;
  global.bullets = 0;
  set_dialog_opacity(0);

  if ((global.mode == "boot" || global.mode == "resume") && global.password_shown == 1) {
    show_progress_bar();
    start_fake_progress();
  }
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
set_dialog_opacity(0);
place_dialog(0);

#----------------------------------------- Progress bar --------------------------------
# Shown after unlock (boot/resume), in the entry box's position. Fake progress eases to 70%
# over 15 s because real progress is frozen during decryption, as in the stock theme.

PP = 15;
progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.x = Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = entry.cy - progress_box.image.GetHeight() / 2;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 3);

progress_bar.original_image = Image("progress_bar.png");
progress_bar.sprite = Sprite();
progress_bar.sprite.SetPosition(progress_box.x, progress_box.y, 5);
progress_glow.original_image = Image("progress_glow.png");
progress_glow.sprite = Sprite();
progress_glow.sprite.SetPosition(progress_box.x - PP, progress_box.y - PP, 4);

global.fake_progress_limit = 0.7;
global.fake_progress_duration = 15.0;
global.fake_progress = 0.0;
global.fake_progress_active = 0;
global.fake_progress_start_frame = 0;
global.fake_progress_start_time = 0.0;
global.max_progress = 0.0;

fun update_progress_bar(progress) {
  if (progress > global.max_progress) {
    global.max_progress = progress;
    w = Math.Int(progress_bar.original_image.GetWidth() * progress);
    if (w < 1) w = 1;
    progress_bar.sprite.SetImage(progress_bar.original_image.Scale(w, progress_bar.original_image.GetHeight()));
    progress_glow.sprite.SetImage(progress_glow.original_image.Scale(w + 2 * PP, progress_glow.original_image.GetHeight()));
  }
}

fun show_progress_bar() {
  progress_box.sprite.SetOpacity(1);
  progress_bar.sprite.SetOpacity(1);
  progress_glow.sprite.SetOpacity(1);
}

fun hide_progress_bar() {
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);
  progress_glow.sprite.SetOpacity(0);
}

fun start_fake_progress() {
  global.fake_progress_active = 1;
  global.fake_progress_start_frame = global.frame;
  global.max_progress = 0.0;
  global.fake_progress = 0.0;
  global.fake_progress_start_time = 0.0;
}

fun stop_fake_progress() {
  global.fake_progress_active = 0;
}

fun progress_callback(duration, progress) {
  if (global.fake_progress_start_time == 0.0) global.fake_progress_start_time = duration;
  if (duration > global.fake_progress_start_time && progress > global.fake_progress) {
    stop_fake_progress();
    update_progress_bar(progress);
  }
}

Plymouth.SetBootProgressFunction(progress_callback);
hide_progress_bar();

#----------------------------------------- Refresh --------------------------------

fun refresh_callback() {
  global.frame++;
  glow.sprite.SetOpacity(glow_opacity());
  animate_dialog();
  if (global.fake_progress_active == 1) {
    r = (global.frame - global.fake_progress_start_frame) / FPS / global.fake_progress_duration;
    if (r > 1) r = 1;
    global.fake_progress = (1 - (1 - r) * (1 - r)) * global.fake_progress_limit;
    update_progress_bar(global.fake_progress);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

#----------------------------------------- Messages --------------------------------

message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10000);

fun display_message_callback(text) {
  message_sprite.SetImage(Image.Text(text, 0.714, 0.694, 0.694));
  message_sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
  message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
